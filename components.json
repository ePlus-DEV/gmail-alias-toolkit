  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "iconLibrary": "lucide",
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "entrypoints/popup/style.css",
    "baseColor": "neutral",
